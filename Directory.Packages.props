<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime (provided in-box on modern TFMs; referenced for net8.0) -->
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.17" />

    <!-- Extensions (used from later phases; pinned centrally now) -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.17" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.17" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="9.0.17" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.17" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="9.0.17" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.17" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.17" />

    <!-- Blazor WebAssembly sample -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" />

    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />

    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />

    <!-- Resilience add-on -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />

    <!-- Durable storage add-on -->
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Pin the native SQLite forward off the 2.1.11 that Microsoft.Data.Sqlite pulls transitively:
         that build bundles SQLite < 3.50.2, vulnerable to CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). 3.50.3
         bundles a patched SQLite; the 2.1.11 managed provider P/Invokes the stable SQLite C API, so the
         newer native binary is a drop-in. Transitive pinning (enabled above) applies it without a direct
         reference. Drop this once Microsoft.Data.Sqlite ships a build on the patched native. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />

    <!-- Serialization add-on -->
    <PackageVersion Include="Google.Protobuf" Version="3.35.1" />
    <PackageVersion Include="MessagePack" Version="3.1.7" />

    <!-- Public API surface guard -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />

    <!-- Analyzer package -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />

    <!-- Integration tests -->
    <PackageVersion Include="Testcontainers" Version="4.12.0" />

    <!-- Comparison benchmarks only -->
    <PackageVersion Include="MQTTnet" Version="5.1.0.1559" />
  </ItemGroup>

</Project>
