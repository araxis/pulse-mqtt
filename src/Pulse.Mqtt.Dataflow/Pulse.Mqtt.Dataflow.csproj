<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);RS0026</NoWarn>
    <PackageId>Pulse.Mqtt.Dataflow</PackageId>
    <Description>Dataflow source blocks for Pulse MQTT client messages, routes, acknowledged routes, and connection state transitions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulse.Mqtt.Client\Pulse.Mqtt.Client.csproj" />
    <ProjectReference Include="..\Pulse.Mqtt.Core\Pulse.Mqtt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulse.Mqtt.Dataflow.Tests" />
  </ItemGroup>

</Project>
